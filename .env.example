# --- Server ---
PORT=3001
JWT_SECRET=replace-with-a-long-random-string
# DATABASE_PATH=server/data/kit.db
# UPLOAD_DIR=server/data/uploads
# Vercel build only: actual Render HTTPS origin, without /api (not needed locally).
# RENDER_API_URL=https://your-kit-service.onrender.com

# --- First admin (used by `npm run seed`) ---
ADMIN_EMAIL=you@yourcompany.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Airfare MCP ---
# Kiwi.com's official MCP server: free, no key. Any other MCP server also works;
# set its search tool name here and KIT will send the Airfare prompt's query.
AIRFARE_MCP_URL=https://mcp.kiwi.com
AIRFARE_MCP_TOOL=search-flight
# Optional JSON headers for auth, e.g. {"Authorization":"Bearer xyz"}
AIRFARE_MCP_HEADERS=

# --- Rental Car MCP ---
# OctoTrip's rental-car MCP server: free, no key. Prices are requested in USD.
# Booking links it returns carry OctoTrip affiliate tracking; KIT only uses the prices.
RENTALCAR_MCP_URL=https://mcp.octotrip.app/rental-cars/mcp
RENTALCAR_MCP_TOOL=search
RENTALCAR_MCP_HEADERS=

# --- GSA Per Diem API (optional; free key from https://api.data.gov/signup) ---
GSA_API_KEY=

# --- Google Workspace (future: Google sign-in + Drive/Calendar grounding) ---
GOOGLE_CLIENT_ID=
